{
  "name": "chthapibot",
  "private": true,
  "type": "module",
  "description": "Multi-utility Telegram bot (crypto, sports, food & drinks, random, daily briefing) on Telegram Serverless",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chethober/chthapibot.git"
  },
  "homepage": "https://t.me/chthapibot",
  "keywords": [
    "telegram",

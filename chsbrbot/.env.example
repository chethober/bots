# Telegram Notification Settings
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=-100123456789
TELEGRAM_ADMIN_ID=8028710032

# NVD API Key (Optional: increases NVD request rate limits)
NVD_API_KEY=

# Cloudflare Worker HTTP Trigger Secret (Optional)
TRIGGER_SECRET=

# Minimum CVSS Score Threshold for Telegram Alerts (Optional, defaults to 6.5)
MIN_CVSS_SCORE=6.5

# GitHub Personal Access Token (Optional: increases GitHub Search API rate limit from 60 to 5,000 req/hr for PoC tracking)
GITHUB_TOKEN=

# Minimum EPSS Score Threshold for Trending Detection (Optional, defaults to 0.15 = 15% probability)
MIN_EPSS_SCORE=0.15


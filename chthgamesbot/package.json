    "run": "NODE_USE_ENV_PROXY=1 tgcloud run",
    "test": "node test/validate.js",
    "test:ui": "node test/ui.js",
    "test:live-ui": "node test/ui.js"
  },
  "devDependencies": {
    "@tgcloud/cli": "^0.2.0",
    "playwright-core": "1.56"

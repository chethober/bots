  "description": "Casino, poker and party games for Telegram — chat games, inline mode and a graphic Mini App on Telegram Serverless. Play-money only.",
  "license": "MIT",
  "author": "chethober",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chethober/games.git"
  },
  "homepage": "https://github.com/chethober/games#readme",
  "bugs": "https://github.com/chethober/games/issues",
  "keywords": [
    "telegram",
    "telegram-bot",
    "telegram-mini-app",
    "serverless",
    "poker",
    "texas-holdem",
    "blackjack",
    "games"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "NODE_USE_ENV_PROXY=1 tgcloud push",
    "migrate": "NODE_USE_ENV_PROXY=1 tgcloud migrate",
